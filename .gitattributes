# Normalise text to LF in the repo (developed on Windows, deployed to Linux).
* text=auto eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.avif binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.mo   binary

# Kept out of `git archive` release zips.
/.gitattributes   export-ignore
/.gitignore       export-ignore
/phpcs.xml.dist   export-ignore
/docs             export-ignore
/tests            export-ignore

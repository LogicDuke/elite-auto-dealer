<?xml version="1.0"?>
<ruleset name="Elite Auto Dealer">
	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<arg name="extensions" value="php"/>

	<config name="minimum_supported_wp_version" value="6.5"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress">
		<!-- Theme file names follow the WordPress template hierarchy, not class-file naming. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="elite-auto-dealer"/>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array" value="eda,EDA"/>
		</properties>
		<!-- 3-letter prefix chosen deliberately; see docs/ARCHITECTURE.md. -->
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals.ShortPrefixPassed"/>
	</rule>
</ruleset>
